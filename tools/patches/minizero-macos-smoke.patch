+                        if (obj.is_none()) { return nullptr; }
+                        return static_cast<float*>(obj.cast<py::array_t<float>>().request().ptr);
+                    };
+                    features_ptr = get_ptr(features);
+                    action_features_ptr = get_ptr(action_features);
+                    policy_ptr = get_ptr(policy);
+                    value_ptr = get_ptr(value);
+                    reward_ptr = get_ptr(reward);
+                    loss_scale_ptr = get_ptr(loss_scale);
+                    if (!sampled_index.is_none()) {
+                        sampled_index_ptr = static_cast<int*>(sampled_index.cast<py::array_t<int>>().request().ptr);
+                    }
+                }
+                data_loader.getSharedData()->getDataPtr()->features_ = features_ptr;
+                data_loader.getSharedData()->getDataPtr()->action_features_ = action_features_ptr;
+                data_loader.getSharedData()->getDataPtr()->policy_ = policy_ptr;
+                data_loader.getSharedData()->getDataPtr()->value_ = value_ptr;
+                data_loader.getSharedData()->getDataPtr()->reward_ = reward_ptr;
+                data_loader.getSharedData()->getDataPtr()->loss_scale_ = loss_scale_ptr;
+                if (sampled_index_ptr) {
+                    data_loader.getSharedData()->getDataPtr()->sampled_index_ = sampled_index_ptr;
+                }
+                py::gil_scoped_release release;
                 data_loader.sampleData();
-            },
-            py::call_guard<py::gil_scoped_release>());
+            });
